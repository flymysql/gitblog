# 复制为 secrets.env 并填写 SMTP_PASS（QQ 邮箱授权码，不是 QQ 密码）
# cp secrets.env.example secrets.env

REPLY_NOTIFY_ENABLED=1
COMMENT_NOTIFY_ENABLED=1
COMMENT_NOTIFY_EMAIL=jimmycppliu@tencent.com
COMMENT_ADMIN_SECRET=请设置一个随机管理密钥
# 后台写文章：CloudBase 校验短密码后，用此 PAT 代理 GitHub Contents API（仅存云函数，不进浏览器）
GITHUB_PAT=github_pat_或_ghp_开头的仓库写入令牌
GITHUB_REPO_OWNER=flymysql
GITHUB_REPO_NAME=gitblog
GITHUB_REPO_BRANCH=main
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=237199972@qq.com
SMTP_PASS=你的QQ邮箱授权码
SMTP_FROM=237199972@qq.com
